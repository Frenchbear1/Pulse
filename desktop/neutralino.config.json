{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.pulse.player",
  "applicationName": "Pulse",
  "author": "David LaBarre",
  "description": "Pulse",
  "version": "1.1.0",
  "defaultMode": "window",
  "port": 41730,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "filesystem.*",
    "server.*",
    "events.*",
    "storage.*",
    "clipboard.*",
    "computer.*"
  ],
  "modes": {
    "window": {
      "title": "Pulse",
      "width": 1280,
      "height": 800,
      "minWidth": 720,
      "minHeight": 480,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/icon-256.png",
      "enableInspector": false,
      "borderless": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false,
      "transparent": true
    }
  },
  "cli": {
    "binaryName": "Pulse",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
