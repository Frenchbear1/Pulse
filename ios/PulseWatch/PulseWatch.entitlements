<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- On the watch this is a SEPARATE container from the phone's (same id, different
	     device). The watch app writes its own now-playing snapshot here for the complication. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.pulse.player</string>
	</array>
</dict>
</plist>
